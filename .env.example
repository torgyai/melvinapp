# Supabase. Leave empty to run the platform on the built-in seeded store (demo mode).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, used for the capture links and QR codes handed to a phone.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Zet dit om de kantoorschermen achter een wachtwoord te zetten. Leeg laten laat
# de app open draaien, wat de demo direct klikbaar houdt.
PLATFORM_PASSWORD=

# Optionele bronnen. Zonder sleutel meldt de interface welke bron niet is geraadpleegd.
BAG_API_KEY=
EP_ONLINE_API_KEY=
